{% extends 'layouts/acesso.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Recuperar senha - {{ app_nome }}{% endblock %}

{% block formulario %}
    <h1>Esqueceu a senha?</h1>
    {% if enviado %}
        <p class="alerta alerta-sucesso" role="status">{{ ui.icone('ok', 20) }}<span>Se o e-mail informado estiver cadastrado, enviamos as instruções para redefinir a senha. O link vale por 30 minutos.</span></p>
    {% else %}
        <p class="lead">Sem problema. Informe o e-mail da sua conta e enviamos um link para você criar uma nova senha.</p>
        {% if erro != '' %}<p class="alerta alerta-erro" role="alert">{{ ui.icone('alerta', 20) }}<span>{{ erro }}</span></p>{% endif %}
        <form method="post" action="/esqueci-senha">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <div class="campo">
                <label for="campo-email">E-mail</label>
                <input id="campo-email" type="email" name="email" value="{{ email }}" required maxlength="190" autocomplete="username" autofocus>
            </div>
            <button type="submit" class="botao-largo">Enviar instruções</button>
        </form>
    {% endif %}
    <p class="acesso-rodape"><a href="/login">Voltar ao login</a></p>
{% endblock %}
