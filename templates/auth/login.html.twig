{% extends 'layouts/base.html.twig' %}

{% block titulo %}Entrar - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <section class="cartao">
        <h1>Entrar</h1>
        {% if aviso != '' %}<p class="aviso">{{ aviso }}</p>{% endif %}
        {% if erro != '' %}<p class="erro" role="alert">{{ erro }}</p>{% endif %}
        <form method="post" action="/login">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <label>E-mail
                <input type="email" name="email" value="{{ email }}" required maxlength="190" autocomplete="username" autofocus>
            </label>
            <label>Senha
                <input type="password" name="senha" required autocomplete="current-password">
            </label>
            <button type="submit">Entrar</button>
        </form>
        <p><a href="/esqueci-senha">Esqueci minha senha</a></p>
    </section>
{% endblock %}
