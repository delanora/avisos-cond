{% extends 'layouts/acesso.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Entrar - {{ app_nome }}{% endblock %}

{% block formulario %}
    <h1>Bem-vindo de volta</h1>
    <p class="lead">Entre com seu e-mail e senha para continuar.</p>

    {% if aviso != '' %}<p class="alerta alerta-sucesso" role="status">{{ ui.icone('ok', 20) }}<span>{{ aviso }}</span></p>{% endif %}
    {% if erro != '' %}<p class="alerta alerta-erro" role="alert">{{ ui.icone('alerta', 20) }}<span>{{ erro }}</span></p>{% endif %}

    <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <div class="campo">
            <label for="campo-email">E-mail</label>
            <input id="campo-email" type="email" name="email" value="{{ email }}" required maxlength="190" autocomplete="username" autofocus>
        </div>
        <div class="campo">
            <label for="campo-senha">Senha</label>
            <input id="campo-senha" type="password" name="senha" required autocomplete="current-password">
        </div>
        <button type="submit" class="botao-largo">Entrar</button>
    </form>
    <p class="acesso-rodape"><a href="/esqueci-senha">Esqueci minha senha</a></p>
{% endblock %}
