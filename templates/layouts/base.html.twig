{% import 'macros/ui.html.twig' as ui %}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titulo %}{{ app_nome }}{% endblock %}</title>
    {% include 'partials/favicon.html.twig' %}
    <link rel="stylesheet" href="/assets/app.css">
    {# Cor de destaque escolhida pelo gerente (o CSP não permite estilo inline, então vem de uma folha própria). #}
    {% if usuario.papel == 'gerente' and usuario.cor_primaria %}<link rel="stylesheet" href="/gerente/tema.css?v={{ usuario.cor_primaria|slice(1) }}">{% endif %}
    {# Cores dos tipos de aviso: as do condomínio da tela (os do gerente + os usados pelos avisos de lá) ou, fora de um condomínio, só as do gerente. #}
    {% if usuario.papel == 'gerente' %}<link rel="stylesheet" href="{% if condominio is defined and condominio %}/gerente/condominios/{{ condominio.id }}/tipos.css{% else %}/gerente/tipos.css{% endif %}">{% endif %}
    {% block cabecalho %}{% endblock %}
</head>
<body>
    {% set menu = menu is defined ? menu : '' %}
    {% if usuario.suporte_admin is defined %}
        <div class="faixa-suporte" role="status">
            <div class="faixa-suporte-interno">
                <span>{{ ui.icone('escudo', 18) }}<strong>Modo suporte:</strong> você está vendo o painel como {{ usuario.nome }}. Tudo que fizer fica registrado em nome de {{ usuario.suporte_admin.nome }}.</span>
                <form method="post" action="/suporte/sair">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <button type="submit" class="botao botao-secundario botao-sutil">Sair do modo suporte</button>
                </form>
            </div>
        </div>
    {% endif %}
    <header class="topo">
        <div class="topo-interno">
            {# Celular: o menu e o perfil ficam atrás do hambúrguer (caixa escondida + CSS, sem JavaScript). #}
            <input type="checkbox" id="menu-toggle" class="menu-toggle">
            <a class="topo-marca" href="/" aria-label="{{ app_nome }} - página inicial">{% include 'partials/logo.html.twig' %}</a>
            {% if usuario.papel == 'gerente' and condominio is defined and condominio %}
                {# Condomínio atual; com mais de um, vira um menu para trocar (sem JavaScript). #}
                <details class="seletor">
                    <summary>{{ ui.icone('predio', 18) }}<span>{{ condominio.nome }}</span>{% if condominios|length > 1 %}{{ ui.icone('seta-baixo', 16) }}{% endif %}</summary>
                    {% if condominios|length > 1 %}
                    <ul class="seletor-lista">
                        {% for c in condominios %}
                            <li><a href="/gerente/condominios/{{ c.id }}/avisos"{% if c.id == condominio.id %} aria-current="true"{% endif %}>{{ c.nome }}</a></li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </details>
            {% endif %}
            <label for="menu-toggle" class="menu-botao" aria-label="Abrir ou fechar o menu"><span class="abre">{{ ui.icone('hamburguer', 22) }}</span><span class="fecha">{{ ui.icone('fechar', 22) }}</span></label>
            <div class="topo-painel"><div class="topo-painel-conteudo">
            <nav class="menu" aria-label="Menu principal">
                {% if usuario.papel == 'gerente' %}
                    <a href="/gerente"{% if menu == 'painel' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('painel', 18) }}Condomínios</a>
                    {% if condominio is defined and condominio %}
                        <a href="/gerente/condominios/{{ condominio.id }}/avisos"{% if menu == 'avisos' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('aviso', 18) }}Avisos</a>
                    {% endif %}
                    <a href="/gerente/dispositivos"{% if menu == 'dispositivos' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('tv', 18) }}Dispositivos</a>
                {% endif %}
                {# Celular: as configurações viram itens do menu (o suspenso da engrenagem fica só no desktop). #}
                {% if usuario.suporte_admin is not defined %}<a class="so-celular{% if menu == 'seguranca' %} ativo{% endif %}" href="/conta/seguranca"{% if menu == 'seguranca' %} aria-current="page"{% endif %}>{{ ui.icone('escudo', 18) }}Segurança</a>
                {% if usuario.papel == 'gerente' %}<a class="so-celular{% if menu == 'aparencia' %} ativo{% endif %}" href="/gerente/aparencia"{% if menu == 'aparencia' %} aria-current="page"{% endif %}>{{ ui.icone('paleta', 18) }}Aparência</a>{% endif %}{% endif %}
                {% if usuario.papel == 'superadmin' %}
                    <a href="/admin"{% if menu == 'painel' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('painel', 18) }}Início</a>
                    <a href="/admin/usuarios"{% if menu == 'usuarios' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('usuarios', 18) }}Usuários</a>
                    <a href="/admin/condominios"{% if menu == 'condominios' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('predio', 18) }}Condomínios</a>
                    <a href="/admin/financeiro"{% if menu == 'financeiro' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('moeda', 18) }}Financeiro</a>
                    <a href="/admin/dispositivos"{% if menu == 'dispositivos' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('tv', 18) }}Dispositivos</a>
                    <a href="/admin/auditoria"{% if menu == 'auditoria' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('prancheta', 18) }}Auditoria</a>
                {% endif %}
            </nav>
            <div class="perfil">
                <div class="perfil-dados">
                    <span class="perfil-nome">{{ usuario.nome }}</span>
                    <span class="perfil-papel">{{ usuario.papel == 'superadmin' ? 'Administrador' : 'Gerente' }}</span>
                </div>
                {# Engrenagem de configurações: Segurança e (para o gerente) Aparência. #}
                {% if usuario.suporte_admin is not defined %}<details class="config">
                    <summary aria-label="Configurações" title="Configurações"{% if menu == 'seguranca' or menu == 'aparencia' %} class="ativo"{% endif %}>{{ ui.icone('engrenagem', 20) }}</summary>
                    <ul class="config-lista">
                        <li><a href="/conta/seguranca"{% if menu == 'seguranca' %} aria-current="page"{% endif %}>{{ ui.icone('escudo', 18) }}Segurança</a></li>
                        {% if usuario.papel == 'gerente' %}<li><a href="/gerente/aparencia"{% if menu == 'aparencia' %} aria-current="page"{% endif %}>{{ ui.icone('paleta', 18) }}Aparência</a></li>{% endif %}
                    </ul>
                </details>{% endif %}
                <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <button type="submit" class="botao-secundario botao-sutil">{{ ui.icone('sair', 16) }}Sair</button>
                </form>
            </div>
            </div></div>
        </div>
    </header>
    <main class="container">
        {# Nome próprio para não sobrescrever variáveis das páginas (ex.: "mensagem" da página de erro). #}
        {% set layout_flash = flash() %}
        {% if layout_flash != '' %}<p class="alerta alerta-sucesso" role="status">{{ ui.icone('ok', 20) }}<span>{{ layout_flash }}</span></p>{% endif %}
        {% block conteudo %}{% endblock %}
    </main>
</body>
</html>
