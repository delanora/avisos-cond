{% import 'macros/ui.html.twig' as ui %}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titulo %}{{ app_nome }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/app.css">
    {# Cor de destaque escolhida pelo gerente (o CSP não permite estilo inline, então vem de uma folha própria). #}
    {% if usuario.papel == 'gerente' and usuario.cor_primaria %}<link rel="stylesheet" href="/gerente/tema.css?v={{ usuario.cor_primaria|slice(1) }}">{% endif %}
    {% if usuario.papel == 'gerente' and condominio is defined and condominio %}<link rel="stylesheet" href="/gerente/condominios/{{ condominio.id }}/tipos.css">{% endif %}
    {% block cabecalho %}{% endblock %}
</head>
<body>
    {% set menu = menu is defined ? menu : '' %}
    <header class="topo">
        <div class="topo-interno">
            <a class="topo-marca" href="/" aria-label="{{ app_nome }} - página inicial">{% include 'partials/logo.html.twig' %}</a>
            {% if usuario.papel == 'gerente' and condominio is defined and condominio %}
                {# Condomínio atual; com mais de um, vira um menu para trocar (sem JavaScript). #}
                <details class="seletor">
                    <summary>{{ ui.icone('predio', 18) }}<span>{{ condominio.nome }}</span>{% if condominios|length > 1 %}{{ ui.icone('seta-baixo', 16) }}{% endif %}</summary>
                    {% if condominios|length > 1 %}
                    <ul class="seletor-lista">
                        {% for c in condominios %}
                            <li><a href="/gerente/condominios/{{ c.id }}/avisos"{% if c.id == condominio.id %} aria-current="true"{% endif %}>{{ c.nome }}</a></li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </details>
            {% endif %}
            <nav class="menu" aria-label="Menu principal">
                {% if usuario.papel == 'gerente' %}
                    <a href="/gerente"{% if menu == 'painel' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('painel', 18) }}Condomínios</a>
                    {% if condominio is defined and condominio %}
                        <a href="/gerente/condominios/{{ condominio.id }}/avisos"{% if menu == 'avisos' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('aviso', 18) }}Avisos</a>
                    {% endif %}
                    <a href="/gerente/aparencia"{% if menu == 'aparencia' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('paleta', 18) }}Aparência</a>
                {% endif %}
                {% if usuario.papel == 'superadmin' %}
                    <a href="/admin"{% if menu == 'painel' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('painel', 18) }}Início</a>
                    <a href="/admin/usuarios"{% if menu == 'usuarios' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('usuarios', 18) }}Usuários</a>
                    <a href="/admin/condominios"{% if menu == 'condominios' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('predio', 18) }}Condomínios</a>
                    <a href="/admin/dispositivos"{% if menu == 'dispositivos' %} class="ativo" aria-current="page"{% endif %}>{{ ui.icone('tv', 18) }}Dispositivos</a>
                {% endif %}
            </nav>
            <div class="perfil">
                <div class="perfil-dados">
                    <span class="perfil-nome">{{ usuario.nome }}</span>
                    <span class="perfil-papel">{{ usuario.papel == 'superadmin' ? 'Administrador' : 'Gerente' }}</span>
                </div>
                {{ ui.avatar(usuario.nome, usuario.id) }}
                <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <button type="submit" class="botao-secundario botao-sutil">{{ ui.icone('sair', 16) }}Sair</button>
                </form>
            </div>
        </div>
    </header>
    <main class="container">
        {# Nome próprio para não sobrescrever variáveis das páginas (ex.: "mensagem" da página de erro). #}
        {% set layout_flash = flash() %}
        {% if layout_flash != '' %}<p class="alerta alerta-sucesso" role="status">{{ ui.icone('ok', 20) }}<span>{{ layout_flash }}</span></p>{% endif %}
        {% block conteudo %}{% endblock %}
    </main>
</body>
</html>
