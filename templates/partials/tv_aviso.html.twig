{# Um aviso do jeito que aparece na TV. Recebe: aviso, tipos, aparencia, url_midia, hora. Medidas em "em": a TV real usa 1.0417vw por em.
   Avisos fixos e urgentes aparecem na faixa do topo (só texto); os demais ocupam a área do carrossel. #}
{% import 'macros/ui.html.twig' as ui %}
{% set na_faixa = aviso.tipo in ['urgente', 'fixo'] %}
<div class="tv-moldura">
    <div class="tv{% if na_faixa %} tv-com-fixos tv-sem-carrossel{% endif %}">
        <header class="tv-topo">
            <span class="tv-logo"><img src="{{ aparencia.logo }}" alt="Logo do condomínio"></span>
            <span class="tv-relogio">{{ hora|slice(11, 5) }}</span>
        </header>
        {% if na_faixa %}
            <div class="tv-fixos tv-fixos-cols-1 tv-fixos-rows-1">
                <article class="tv-fixo tv-fixo-{{ aviso.tipo }}">
                    <div class="tv-fixo-conteudo">
                        <span class="tv-fixo-tipo">{{ ui.icone(aviso.tipo == 'urgente' ? 'alerta' : 'fixar', 20) }}<span>{{ tipos[aviso.tipo] }}</span></span>
                        <h2 class="tv-fixo-titulo">{{ aviso.titulo }}</h2>
                        {% if aviso.corpo != '' %}<p class="tv-fixo-texto">{{ aviso.corpo }}</p>{% endif %}
                    </div>
                </article>
            </div>
            <div class="tv-ocioso">
                <span class="tv-ocioso-texto">Os avisos em carrossel aparecem aqui</span>
            </div>
        {% else %}
            <div class="tv-corpo{% if aviso.midia %} tv-com-midia{% endif %}">
                <div class="tv-texto-bloco">
                    <span class="tv-tipo">{{ tipos[aviso.tipo] }}</span>
                    <h2 class="tv-titulo">{{ aviso.titulo }}</h2>
                    {% if aviso.corpo != '' %}<p class="tv-texto">{{ aviso.corpo }}</p>{% endif %}
                </div>
                {% if aviso.midia %}
                    <div class="tv-midia">
                        {% if aviso.midia_tipo == 'imagem' %}
                            <img src="{{ url_midia }}" alt="">
                        {% else %}
                            <video src="{{ url_midia }}" controls muted preload="metadata"></video>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
