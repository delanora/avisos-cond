{# Ícones (estilo Lucide, traço de 2px) e avatar. Os ícones herdam a cor do texto (currentColor). #}
{% macro icone(nome, tamanho) %}
    {%- set caminhos = {
        'plus': ['M5 12h14', 'M12 5v14'],
        'editar': ['M12 20h9', 'M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z'],
        'lixeira': ['M3 6h18', 'M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6', 'M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2', 'M10 11v6', 'M14 11v6'],
        'sair': ['M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4', 'M16 17l5-5-5-5', 'M21 12H9'],
        'usuarios': ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8', 'M22 21v-2a4 4 0 0 0-3-3.87', 'M16 3.13a4 4 0 0 1 0 7.75'],
        'predio': ['M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z', 'M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2', 'M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2', 'M10 6h4', 'M10 10h4', 'M10 14h4', 'M10 18h4'],
        'painel': ['M3 3h7v9H3z', 'M14 3h7v5h-7z', 'M14 12h7v9h-7z', 'M3 16h7v5H3z'],
        'ok': ['M22 11.08V12a10 10 0 1 1-5.93-9.14', 'M22 4 12 14.01l-3-3'],
        'seta': ['M5 12h14', 'M12 5l7 7-7 7'],
        'escudo': ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'],
        'alerta': ['M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z', 'M12 9v4', 'M12 17h.01'],
        'voltar': ['M19 12H5', 'M12 19l-7-7 7-7'],
        'tv': ['M2 7h20v13H2z', 'M17 2l-5 5-5-5']
    } -%}
    <svg class="icone" width="{{ tamanho|default(20) }}" height="{{ tamanho|default(20) }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {%- for d in caminhos[nome] %}<path d="{{ d }}"/>{% endfor -%}
    </svg>
{%- endmacro %}

{# Círculo com a inicial do nome; a cor muda conforme o id, sempre a mesma para a mesma pessoa. #}
{% macro avatar(nome, id, pequeno) %}
    <span class="avatar{% if pequeno|default(false) %} avatar-sm{% endif %} av-{{ id % 6 }}" aria-hidden="true">{{ nome|first }}</span>
{%- endmacro %}
