    <svg class="icone" width="{{ tamanho|default(20) }}" height="{{ tamanho|default(20) }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {%- for d in caminhos[nome] %}<path d="{{ d }}"/>{% endfor -%}
    </svg>
{%- endmacro %}

{# Círculo com a inicial do nome; a cor muda conforme o id, sempre a mesma para a mesma pessoa. #}
{% macro avatar(nome, id, pequeno) %}
    <span class="avatar{% if pequeno|default(false) %} avatar-sm{% endif %} av-{{ id % 6 }}" aria-hidden="true">{{ nome|first }}</span>
{%- endmacro %}
