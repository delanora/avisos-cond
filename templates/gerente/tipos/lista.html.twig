{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Tipos de aviso - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/gerente">Avisos</a> {{ ui.icone('seta', 14) }} <span>Tipos de aviso</span></p>
    <div class="pagina-topo">
        <div>
            <h1>Tipos de aviso</h1>
            <p>Os seus tipos de aviso. Só você os vê e pode editar ou apagar qualquer um, inclusive os que já vinham prontos. Cada tipo tem uma cor e pode ser fixo (sempre à vista na faixa do topo da TV).</p>
        </div>
        <a class="botao" href="/gerente/tipos/novo">{{ ui.icone('plus', 18) }}Novo tipo</a>
    </div>

    <div class="cartao cartao-sem-espaco">
        <div class="tabela-rolagem">
            <table>
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th class="esconde-movel">Exibição</th>
                        <th class="esconde-movel">Avisos</th>
                        <th><span class="sr-only">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                {% for t in tipos %}
                    <tr>
                        <td><span class="etiqueta etiqueta-tipo-t{{ t.id }}">{{ t.nome }}</span></td>
                        <td class="celula-suave esconde-movel">{{ t.fixo ? 'Fixo na faixa do topo' : 'Carrossel' }}</td>
                        <td class="celula-suave esconde-movel">{{ t.em_uso }}</td>
                        <td class="acoes-celula">
                            <a class="botao-icone" href="/gerente/tipos/{{ t.id }}/editar" title="Editar" aria-label="Editar {{ t.nome }}">{{ ui.icone('editar', 18) }}</a>
                            <a class="botao-icone perigo" href="/gerente/tipos/{{ t.id }}/excluir" title="Excluir" aria-label="Excluir {{ t.nome }}">{{ ui.icone('lixeira', 18) }}</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
