{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Dispositivos - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <div class="pagina-topo">
        <div>
            <h1>Dispositivos</h1>
            <p>As TVs dos seus condomínios e se estão conectadas agora.</p>
        </div>
    </div>

    {% if total > 0 %}
        <nav class="filtros-situacao" aria-label="Filtrar por situação">
            <a class="filtro{% if filtro == '' %} filtro-ativo{% endif %}" href="/gerente/dispositivos"{% if filtro == '' %} aria-current="true"{% endif %}>Todos <strong>{{ total }}</strong></a>
            {% for chave, rotulo in rotulos %}
                {% if contagem[chave] > 0 or filtro == chave %}
                    <a class="filtro{% if filtro == chave %} filtro-ativo{% endif %}" href="/gerente/dispositivos?situacao={{ chave }}"{% if filtro == chave %} aria-current="true"{% endif %}>{{ rotulo }} <strong>{{ contagem[chave] }}</strong></a>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}

    {% if total == 0 %}
        <div class="cartao vazio">
            <span class="vazio-icone">{{ ui.icone('tv', 30) }}</span>
            <h2>Nenhum dispositivo por aqui ainda</h2>
            <p>As TVs dos seus condomínios são cadastradas pela equipe da Embracore. Quando houver alguma, ela aparece aqui.</p>
        </div>
    {% elseif dispositivos|length == 0 %}
        <div class="cartao vazio">
            <span class="vazio-icone">{{ ui.icone('tv', 30) }}</span>
            <h2>Nenhum dispositivo nesta situação</h2>
            <p><a href="/gerente/dispositivos">Ver todos os dispositivos</a></p>
        </div>
    {% else %}
        <div class="cartao cartao-sem-espaco">
            <div class="tabela-rolagem">
                <table>
                    <thead>
                        <tr>
                            <th>Dispositivo</th>
                            <th class="esconde-movel">Último contato</th>
                            <th>Situação</th>
                            <th><span class="sr-only">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for d in dispositivos %}
                        <tr>
                            <td class="pessoa-celula">
                                <div class="pessoa">
                                    <span class="avatar av-{{ d.condominio_id % 6 }}" aria-hidden="true">{{ ui.icone('tv', 20) }}</span>
                                    <div>
                                        <a class="pessoa-nome" href="/gerente/dispositivos/{{ d.id }}">{{ d.nome }}</a>
                                        <span class="pessoa-sub">{{ d.condominio_nome }}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="celula-suave esconde-movel">{{ ultimo_contato[d.id] }}</td>
                            <td><span class="etiqueta etiqueta-disp-{{ d.situacao }}">{{ rotulos[d.situacao] }}</span></td>
                            <td class="acoes-celula">
                                <a class="botao-icone" href="/gerente/dispositivos/{{ d.id }}" title="Ver detalhes" aria-label="Ver detalhes de {{ d.nome }}">{{ ui.icone('olho', 18) }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
