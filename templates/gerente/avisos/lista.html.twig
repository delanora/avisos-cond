{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Avisos - {{ condominio.nome }} - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <div class="pagina-topo">
        <div>
            <h1>Avisos</h1>
            <p>O que aparece na TV do {{ condominio.nome }}.</p>
        </div>
        <div class="acoes sem-margem">
            <a class="botao botao-secundario" href="/gerente/condominios/{{ condominio.id }}/tipos">{{ ui.icone('paleta', 18) }}Tipos de aviso</a>
            <a class="botao" href="/gerente/condominios/{{ condominio.id }}/avisos/novo">{{ ui.icone('plus', 18) }}Novo aviso</a>
        </div>
    </div>

    {% if avisos|length == 0 %}
        <div class="cartao vazio">
            <span class="vazio-icone">{{ ui.icone('aviso', 30) }}</span>
            <h2>Nenhum aviso por aqui</h2>
            <p>Crie o primeiro aviso e ele aparece na TV do condomínio no horário que você escolher.</p>
            <a class="botao" href="/gerente/condominios/{{ condominio.id }}/avisos/novo">{{ ui.icone('plus', 18) }}Novo aviso</a>
        </div>
    {% else %}
        <div class="cartao cartao-sem-espaco">
            <div class="tabela-rolagem">
                <table>
                    <thead>
                        <tr>
                            <th>Aviso</th>
                            <th class="esconde-movel">Período de exibição</th>
                            <th>Situação</th>
                            <th><span class="sr-only">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for a in avisos %}
                        <tr>
                            <td class="pessoa-celula">
                                <span class="pessoa-nome">{{ a.titulo }}</span>
                                <span class="pessoa-sub">
                                    <span class="etiqueta etiqueta-tipo-t{{ a.tipo_id }}">{{ a.tipo_nome }}</span>
                                    {% if a.midia_tipo == 'imagem' %}<span class="etiqueta">{{ ui.icone('imagem', 14) }}Imagem</span>{% endif %}
                                    {% if a.midia_tipo == 'video' %}<span class="etiqueta">{{ ui.icone('video', 14) }}Vídeo</span>{% endif %}
                                </span>
                            </td>
                            <td class="celula-suave esconde-movel">{{ a.inicio_epoch|date('d/m/Y H:i', 'America/Sao_Paulo') }} até {{ a.fim_epoch|date('d/m/Y H:i', 'America/Sao_Paulo') }}</td>
                            <td><span class="etiqueta etiqueta-situacao-{{ a.situacao.codigo }}">{{ a.situacao.rotulo }}</span></td>
                            <td class="acoes-celula">
                                <a class="botao-icone" href="/gerente/condominios/{{ condominio.id }}/avisos/{{ a.id }}/previa" title="Ver como fica na TV" aria-label="Ver na TV: {{ a.titulo }}">{{ ui.icone('olho', 18) }}</a>
                                <a class="botao-icone" href="/gerente/condominios/{{ condominio.id }}/avisos/{{ a.id }}/editar" title="Editar" aria-label="Editar {{ a.titulo }}">{{ ui.icone('editar', 18) }}</a>
                                <a class="botao-icone perigo" href="/gerente/condominios/{{ condominio.id }}/avisos/{{ a.id }}/excluir" title="Excluir" aria-label="Excluir {{ a.titulo }}">{{ ui.icone('lixeira', 18) }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
