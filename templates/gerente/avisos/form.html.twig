{% extends 'layouts/base.html.twig' %}
{% import 'macros/form.html.twig' as f %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}{{ editando ? 'Editar aviso' : 'Novo aviso' }} - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/gerente/condominios/{{ condominio.id }}/avisos">Avisos</a> {{ ui.icone('seta', 14) }} <span>{{ editando ? 'Editar' : 'Novo' }}</span></p>
    <div class="pagina-topo">
        <div>
            <h1>{{ editando ? 'Editar aviso' : 'Novo aviso' }}</h1>
            <p>{{ condominio.nome }}</p>
        </div>
        {% if editando %}
            <a class="botao botao-secundario" href="/gerente/condominios/{{ condominio.id }}/avisos/{{ aviso.id }}/previa">{{ ui.icone('olho', 18) }}Ver como fica na TV</a>
        {% endif %}
    </div>

    {% if not editando and modelos|length > 0 %}
        <form method="get" action="{{ acao }}/novo" class="cartao formulario modelo-escolha">
            <div class="campo">
                <label for="campo-modelo">Começar de um modelo</label>
                <div class="modelo-linha">
                    <select id="campo-modelo" name="modelo">
                        {% for m in modelos %}<option value="{{ m.id }}">{{ m.nome }}</option>{% endfor %}
                    </select>
                    <button type="submit" class="botao-secundario">Usar modelo</button>
                </div>
                <p class="campo-ajuda">Preenche título, texto e tipo; você ajusta o que quiser. <a href="/gerente/modelos">Gerenciar modelos</a></p>
            </div>
        </form>
    {% endif %}

    <form method="post" action="{{ acao }}" enctype="multipart/form-data" class="cartao formulario">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <section class="formulario-secao">
            <h2>O que vai aparecer</h2>
            <p class="secao-ajuda">Seja direto: quem passa pela TV lê em poucos segundos.</p>
            {{ f.campo('titulo', 'Título', 'text', valores.titulo, erros.titulo|default(''), {obrigatorio: true, max: 150}) }}

            <div class="campo{% if erros.corpo is defined %} campo-erro{% endif %}">
                <label for="campo-corpo">Texto do aviso</label>
                <textarea id="campo-corpo" name="corpo" rows="5" maxlength="2000"{% if erros.corpo is defined %} aria-invalid="true"{% endif %}>{{ valores.corpo }}</textarea>
                <p class="campo-ajuda">Opcional. Até 2.000 caracteres; as quebras de linha são mantidas.</p>
                {% if erros.corpo is defined %}<p class="erro-texto">{{ erros.corpo }}</p>{% endif %}
            </div>

            <div class="campo{% if erros.tipo is defined %} campo-erro{% endif %}">
                <label for="campo-tipo">Tipo</label>
                <select id="campo-tipo" name="tipo"{% if erros.tipo is defined %} aria-invalid="true"{% endif %}>
                    {% if tipo_de_outro %}<option value="__atual"{% if valores.tipo == '__atual' %} selected{% endif %}>{{ tipo_de_outro.tipo_nome }}{% if tipo_de_outro.fixo %} (fixo){% endif %} (tipo atual do aviso, de outro gerente)</option>{% endif %}
                    {% for t in tipos %}
                        <option value="{{ t.chave }}"{% if valores.tipo == t.chave %} selected{% endif %}>{{ t.nome }}{% if t.fixo %} (fixo){% endif %}</option>
                    {% endfor %}
                </select>
                <p class="campo-ajuda">Tipos <strong>fixos</strong> ficam sempre à vista numa faixa no topo da TV, mostrando só o texto; com vários, a faixa é dividida entre eles. Os demais passam em carrossel, com foto ou vídeo. Os tipos de fábrica já vêm prontos e são seus: você pode editar e apagar.</p>
                {% if erros.tipo is defined %}<p class="erro-texto">{{ erros.tipo }}</p>{% endif %}
            </div>

            <label class="opcao opcao-simples"><input type="checkbox" name="salvar_modelo" value="1"{% if valores.salvar_modelo %} checked{% endif %}> Salvar título, texto e tipo como um modelo, para usar em outros avisos</label>

            <details class="novo-tipo"{% if valores.novo_tipo_nome != '' or erros.novo_tipo_nome is defined or erros.novo_tipo_cor is defined %} open{% endif %}>
                <summary>{{ ui.icone('plus', 16) }}Criar um tipo novo</summary>
                <p class="secao-ajuda">Se preencher o nome, o tipo é criado ao salvar o aviso e usado nele (o seletor acima é ignorado). Depois ele aparece na lista para os próximos avisos deste condomínio. Os tipos são só seus (outros gerentes não os veem). Para editar ou apagar, use <a href="/gerente/tipos">Tipos de aviso</a>.</p>
                <div class="grade-2">
                    <div class="campo{% if erros.novo_tipo_nome is defined %} campo-erro{% endif %}">
                        <label for="campo-novo_tipo_nome">Nome do tipo</label>
                        <input id="campo-novo_tipo_nome" type="text" name="novo_tipo_nome" maxlength="30" value="{{ valores.novo_tipo_nome }}"{% if erros.novo_tipo_nome is defined %} aria-invalid="true"{% endif %}>
                        {% if erros.novo_tipo_nome is defined %}<p class="erro-texto">{{ erros.novo_tipo_nome }}</p>{% endif %}
                    </div>
                    <div class="campo{% if erros.novo_tipo_cor is defined %} campo-erro{% endif %}">
                        <label for="campo-novo_tipo_cor">Cor principal</label>
                        <input id="campo-novo_tipo_cor" type="color" name="novo_tipo_cor" value="{{ valores.novo_tipo_cor }}">
                        <p class="campo-ajuda">O fundo do cartão na TV é um tom mais claro desta cor, calculado sozinho.</p>
                        {% if erros.novo_tipo_cor is defined %}<p class="erro-texto">{{ erros.novo_tipo_cor }}</p>{% endif %}
                    </div>
                </div>
                <label class="opcao opcao-simples"><input type="checkbox" name="novo_tipo_fixo" value="1"{% if valores.novo_tipo_fixo %} checked{% endif %}> Aviso fixo (sempre à vista na faixa do topo da TV)</label>
            </details>
        </section>

        <section class="formulario-secao">
            <h2>Repetição (opcional)</h2>
            <p class="secao-ajuda">Dentro do período acima, o aviso aparece só nos dias e no horário que você escolher (horário de Brasília). Com todos os dias marcados e o dia inteiro (00:00 às 23:59), ele fica no ar o período todo.</p>
            <fieldset class="campo{% if erros.dias is defined %} campo-erro{% endif %}">
                <legend>Dias da semana</legend>
                <div class="dias-semana">
                    {% for numero, nome in dias_semana %}
                        <label class="opcao"><input type="checkbox" name="dias[]" value="{{ numero }}"{% if numero in valores.dias %} checked{% endif %}><span>{{ nome }}</span></label>
                    {% endfor %}
                </div>
                {% if erros.dias is defined %}<p class="erro-texto">{{ erros.dias }}</p>{% endif %}
            </fieldset>
            <div class="horario-linha">
                <div class="campo">
                    <label for="campo-hora_inicio">Das</label>
                    <input id="campo-hora_inicio" type="time" name="hora_inicio" value="{{ valores.hora_inicio }}">
                </div>
                <div class="campo{% if erros.hora_fim is defined %} campo-erro{% endif %}">
                    <label for="campo-hora_fim">Até as</label>
                    <input id="campo-hora_fim" type="time" name="hora_fim" value="{{ valores.hora_fim }}"{% if erros.hora_fim is defined %} aria-invalid="true"{% endif %}>
                    {% if erros.hora_fim is defined %}<p class="erro-texto">{{ erros.hora_fim }}</p>{% endif %}
                </div>
            </div>
            <p class="campo-ajuda">Exemplo: terças e sextas, das 07:00 às 09:00, para lembrar a coleta de lixo. O horário não pode passar da meia-noite.</p>
        </section>

        <section class="formulario-secao">
            <h2>Foto ou vídeo</h2>
            <p class="secao-ajuda">Opcional. Imagem JPG, PNG ou WebP, ou vídeo MP4 curto. Não aceitamos PDF. A foto ou o vídeo só aparecem em avisos do carrossel (não em avisos Fixo ou Urgente).</p>

            {% if editando and aviso.midia %}
                <div class="midia-atual">
                    {% if aviso.midia_tipo == 'imagem' %}
                        <img src="{{ url_midia }}" alt="Mídia atual do aviso" class="midia-miniatura">
                    {% else %}
                        <video src="{{ url_midia }}" class="midia-miniatura" controls muted preload="metadata"></video>
                    {% endif %}
                    <label class="opcao opcao-simples"><input type="checkbox" name="remover_midia" value="1"> Remover a mídia atual</label>
                </div>
            {% endif %}

            <div class="campo{% if erros.midia is defined %} campo-erro{% endif %}">
                <label for="campo-midia">{{ editando and aviso.midia ? 'Trocar por outro arquivo' : 'Arquivo' }}</label>
                <input id="campo-midia" type="file" name="midia" accept=".jpg,.jpeg,.png,.webp,.mp4,image/jpeg,image/png,image/webp,video/mp4"{% if erros.midia is defined %} aria-invalid="true"{% endif %}>
                {% if erros.midia is defined %}<p class="erro-texto">{{ erros.midia }}</p>{% endif %}
            </div>
        </section>

        <section class="formulario-secao">
            <h2>Quando exibir</h2>
            <p class="secao-ajuda">Horário de Brasília. O aviso entra e sai da TV sozinho.</p>
            <div class="grade-2">
                {{ f.campo('inicio_em', 'Começa em', 'datetime-local', valores.inicio_em, erros.inicio_em|default(''), {obrigatorio: true}) }}
                {{ f.campo('fim_em', 'Termina em', 'datetime-local', valores.fim_em, erros.fim_em|default(''), {obrigatorio: true}) }}
            </div>
            <div class="campo">
                <label class="opcao opcao-simples">
                    <input type="checkbox" name="ativo" value="1"{% if valores.ativo %} checked{% endif %}>
                    Aviso ativo
                </label>
                <p class="campo-ajuda">Desmarque para guardar o aviso sem exibir.</p>
            </div>
        </section>

        <div class="acoes">
            <button type="submit">{{ editando ? 'Salvar alterações' : 'Criar aviso' }}</button>
            <a class="botao botao-secundario" href="/gerente/condominios/{{ condominio.id }}/avisos">Cancelar</a>
        </div>
    </form>
{% endblock %}
