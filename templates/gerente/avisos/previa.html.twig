{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Prévia na TV - {{ app_nome }}{% endblock %}

{% block cabecalho %}<link rel="stylesheet" href="/assets/tv.css">{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/gerente/condominios/{{ condominio.id }}/avisos">Avisos</a> {{ ui.icone('seta', 14) }} <span>Prévia na TV</span></p>
    <div class="pagina-topo">
        <div>
            <h1>Como fica na TV</h1>
            <p>É assim que o aviso aparece para quem passa pelo elevador do {{ condominio.nome }}.</p>
        </div>
        <a class="botao botao-secundario" href="/gerente/condominios/{{ condominio.id }}/avisos/{{ aviso.id }}/editar">{{ ui.icone('editar', 18) }}Editar aviso</a>
    </div>

    {% if aviso.fixo %}
        <p class="alerta alerta-sucesso" role="status">{{ ui.icone('aviso', 20) }}<span>Aviso do tipo {{ aviso.tipo_nome }} (fixo): fica sempre à vista na faixa do topo da TV, só com o texto. Se houver outros avisos fixos, a faixa é dividida entre eles.{% if aviso.midia %} A foto ou o vídeo deste aviso não são exibidos na TV.{% endif %}</span></p>
    {% endif %}

    {% if aviso.dias_semana is not null or aviso.hora_inicio is not null %}
        <p class="alerta alerta-sucesso" role="status">{{ ui.icone('relogio', 20) }}<span>Este aviso se repete: aparece na TV só nos dias e no horário escolhidos, dentro do período dele. Aqui você vê como ele fica quando está no ar.</span></p>
    {% endif %}

    {% if not aviso.ativo %}
        <p class="alerta alerta-erro" role="status">{{ ui.icone('alerta', 20) }}<span>Este aviso está desativado e não aparece na TV.</span></p>
    {% endif %}

    {% include 'partials/tv_aviso.html.twig' %}
{% endblock %}
