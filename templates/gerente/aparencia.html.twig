{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Aparência - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <div class="pagina-topo">
        <div>
            <h1>Aparência</h1>
            <p>Escolha a cor do seu painel. Ela vale só para você e muda tudo o que hoje é verde. Os tons mais claros são calculados sozinhos.</p>
        </div>
    </div>

    <form method="post" action="/gerente/aparencia" class="cartao formulario">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <section class="formulario-secao">
            <h2>Cor de destaque</h2>
            <div class="campo{% if erros.cor_primaria is defined %} campo-erro{% endif %}">
                <label for="campo-cor_primaria">Cor principal</label>
                <input id="campo-cor_primaria" type="color" name="cor_primaria" value="{{ valores.cor_primaria }}"{% if erros.cor_primaria is defined %} aria-invalid="true"{% endif %}>
                {% if erros.cor_primaria is defined %}<p class="erro-texto">{{ erros.cor_primaria }}</p>{% endif %}
            </div>
            <label class="opcao opcao-simples">
                <input type="checkbox" name="usar_padrao" value="1"{% if valores.usar_padrao %} checked{% endif %}>
                Usar a cor padrão da Embracore
            </label>
            <p class="campo-ajuda">Com esta opção marcada, a cor escolhida acima é ignorada.</p>
        </section>

        <section class="formulario-secao">
            <h2>Como fica</h2>
            <p class="secao-ajuda">As cores abaixo saem da sua cor principal (a tela só muda depois de salvar).</p>
            <div class="aparencia">
                {% for nome, titulo in {'--marca': 'Principal', '--marca-700': 'Botões e links', '--marca-100': 'Realce claro', '--marca-50': 'Fundo suave'} %}
                    <span class="aparencia-cor">
                        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6" fill="{{ paleta[nome] }}"/></svg>
                        {{ titulo }} · {{ paleta[nome] }}
                    </span>
                {% endfor %}
            </div>
        </section>

        <div class="acoes">
            <button type="submit">Salvar aparência</button>
            <a class="botao botao-secundario" href="/gerente">Voltar</a>
        </div>
    </form>
{% endblock %}
