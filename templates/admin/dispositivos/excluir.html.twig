{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% set menu = 'dispositivos' %}

{% block titulo %}Excluir dispositivo - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/admin/dispositivos">Dispositivos</a> {{ ui.icone('seta', 14) }} <span>Excluir</span></p>
    <div class="pagina-topo"><h1>Excluir dispositivo</h1></div>

    <div class="cartao formulario">
        <p class="texto-confirmacao">Tem certeza de que deseja excluir <strong>{{ dispositivo.nome }}</strong> ({{ dispositivo.condominio_nome }})?</p>
        <p class="alerta alerta-erro">{{ ui.icone('alerta', 20) }}<span>O endereço da TV deixa de funcionar e não pode ser recuperado. Para apenas parar a exibição, revogue o dispositivo na edição.</span></p>
        <form method="post" action="/admin/dispositivos/{{ dispositivo.id }}/excluir" class="acoes">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <button type="submit" class="botao-perigo">{{ ui.icone('lixeira', 18) }}Excluir dispositivo</button>
            <a class="botao botao-secundario" href="/admin/dispositivos/{{ dispositivo.id }}">Cancelar</a>
        </form>
    </div>
{% endblock %}
