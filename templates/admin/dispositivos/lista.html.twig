{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% set menu = 'dispositivos' %}

{% block titulo %}Dispositivos - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <div class="pagina-topo">
        <div>
            <h1>Dispositivos</h1>
            <p>As TVs e mini PCs que exibem os avisos. Cada um abre um endereço próprio, com um token curto.</p>
        </div>
        <a class="botao" href="/admin/dispositivos/novo">{{ ui.icone('plus', 18) }}Novo dispositivo</a>
    </div>

    {% if dispositivos|length == 0 %}
        <div class="cartao vazio">
            <span class="vazio-icone">{{ ui.icone('tv', 30) }}</span>
            <h2>Nenhum dispositivo cadastrado</h2>
            <p>Cadastre a TV de um condomínio para gerar o endereço que ela vai abrir.</p>
            <a class="botao" href="/admin/dispositivos/novo">{{ ui.icone('plus', 18) }}Novo dispositivo</a>
        </div>
    {% else %}
        <div class="cartao cartao-sem-espaco">
            <div class="tabela-rolagem">
                <table>
                    <thead>
                        <tr>
                            <th>Dispositivo</th>
                            <th class="esconde-movel">Último contato</th>
                            <th>Situação</th>
                            <th><span class="sr-only">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for d in dispositivos %}
                        <tr>
                            <td class="pessoa-celula">
                                <div class="pessoa">
                                    <span class="avatar av-{{ d.condominio_id % 6 }}" aria-hidden="true">{{ ui.icone('tv', 20) }}</span>
                                    <div>
                                        <a class="pessoa-nome" href="/admin/dispositivos/{{ d.id }}">{{ d.nome }}</a>
                                        <span class="pessoa-sub">{{ d.condominio_nome }}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="celula-suave esconde-movel">{{ ultimo_contato[d.id] }}</td>
                            <td><span class="etiqueta {{ d.ativo ? 'etiqueta-ok' : 'etiqueta-off' }}">{{ d.ativo ? 'Ativo' : 'Revogado' }}</span></td>
                            <td class="acoes-celula">
                                <a class="botao-icone" href="/admin/dispositivos/{{ d.id }}" title="Ver endereço da TV" aria-label="Ver endereço de {{ d.nome }}">{{ ui.icone('olho', 18) }}</a>
                                <a class="botao-icone" href="/admin/dispositivos/{{ d.id }}/editar" title="Editar" aria-label="Editar {{ d.nome }}">{{ ui.icone('editar', 18) }}</a>
                                <a class="botao-icone perigo" href="/admin/dispositivos/{{ d.id }}/excluir" title="Excluir" aria-label="Excluir {{ d.nome }}">{{ ui.icone('lixeira', 18) }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
