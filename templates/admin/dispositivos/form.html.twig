{% extends 'layouts/base.html.twig' %}
{% import 'macros/form.html.twig' as f %}
{% import 'macros/ui.html.twig' as ui %}
{% set menu = 'dispositivos' %}

{% block titulo %}{{ editando ? 'Editar dispositivo' : 'Novo dispositivo' }} - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/admin/dispositivos">Dispositivos</a> {{ ui.icone('seta', 14) }} <span>{{ editando ? 'Editar' : 'Novo' }}</span></p>
    <div class="pagina-topo">
        <div>
            <h1>{{ editando ? 'Editar dispositivo' : 'Novo dispositivo' }}</h1>
            <p>{{ editando ? 'Altere o nome, o condomínio ou revogue o acesso desta TV.' : 'Ao salvar, geramos o endereço que a TV vai abrir.' }}</p>
        </div>
    </div>

    <form method="post" action="{{ acao }}" class="cartao formulario">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <section class="formulario-secao">
            <h2>Dados do dispositivo</h2>
            <p class="secao-ajuda">O nome ajuda a identificar a TV, por exemplo "Elevador social" ou "Portaria".</p>
            {{ f.campo('nome', 'Nome', 'text', valores.nome, erros.nome|default(''), {obrigatorio: true, max: 100}) }}

            <div class="campo{% if erros.condominio_id is defined %} campo-erro{% endif %}">
                <label for="campo-condominio_id">Condomínio</label>
                <select id="campo-condominio_id" name="condominio_id" required>
                    <option value="">Escolha o condomínio</option>
                    {% for c in condominios %}
                        <option value="{{ c.id }}"{% if valores.condominio_id == c.id %} selected{% endif %}>{{ c.nome }}{% if not c.ativo %} (inativo){% endif %}</option>
                    {% endfor %}
                </select>
                {% if erros.condominio_id is defined %}<p class="erro-texto">{{ erros.condominio_id }}</p>{% endif %}
            </div>

            {% if editando %}
            <div class="campo">
                <label class="opcao opcao-simples">
                    <input type="checkbox" name="ativo" value="1"{% if valores.ativo %} checked{% endif %}>
                    Dispositivo ativo
                </label>
                <p class="campo-ajuda">Desmarque para revogar: a TV deixa de mostrar avisos (fica só o relógio) e o endereço passa a dar "não encontrado".</p>
            </div>
            {% endif %}
        </section>

        <div class="acoes">
            <button type="submit">{{ editando ? 'Salvar alterações' : 'Criar dispositivo' }}</button>
            <a class="botao botao-secundario" href="/admin/dispositivos">Cancelar</a>
        </div>
    </form>
{% endblock %}
