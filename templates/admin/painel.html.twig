{% extends 'layouts/base.html.twig' %}
{% set menu = 'painel' %}

{% block titulo %}Painel Embracore - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <h1>Painel Embracore</h1>
    <p>Bem-vindo(a), {{ usuario.nome }}. Gerencie os gerentes, os condomínios e os vínculos entre eles.</p>

    <div class="atalhos">
        <a class="cartao atalho" href="/admin/usuarios">
            <h2>Usuários</h2>
            <p>Cadastre gerentes e administradores, defina a quais condomínios cada gerente tem acesso e redefina senhas.</p>
        </a>
        <a class="cartao atalho" href="/admin/condominios">
            <h2>Condomínios</h2>
            <p>Cadastre condomínios e escolha os gerentes responsáveis.</p>
        </a>
    </div>
{% endblock %}
