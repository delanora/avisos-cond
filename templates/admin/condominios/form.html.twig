{% extends 'layouts/base.html.twig' %}
{% import 'macros/form.html.twig' as f %}
{% import 'macros/ui.html.twig' as ui %}
{% set menu = 'condominios' %}

{% block titulo %}{{ editando ? 'Editar condomínio' : 'Novo condomínio' }} - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/admin/condominios">Condomínios</a> {{ ui.icone('seta', 14) }} <span>{{ editando ? 'Editar' : 'Novo' }}</span></p>
    <div class="pagina-topo">
        <div>
            <h1>{{ editando ? 'Editar condomínio' : 'Novo condomínio' }}</h1>
            <p>{{ editando ? 'Atualize os dados e escolha quem gerencia este condomínio.' : 'Informe os dados e escolha os gerentes responsáveis.' }}</p>
        </div>
    </div>

    <form method="post" action="{{ acao }}" class="cartao formulario">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <section class="formulario-secao">
            <h2>Dados do condomínio</h2>
            <p class="secao-ajuda">O endereço é opcional e serve só para identificar o condomínio na lista.</p>
            {{ f.campo('nome', 'Nome', 'text', valores.nome, erros.nome|default(''), {obrigatorio: true, max: 150}) }}
            {{ f.campo('endereco', 'Endereço', 'text', valores.endereco, erros.endereco|default(''), {max: 255, autocomplete: 'off'}) }}
            <div class="campo">
                <label class="opcao opcao-simples">
                    <input type="checkbox" name="ativo" value="1"{% if valores.ativo %} checked{% endif %}>
                    Condomínio ativo
                </label>
                <p class="campo-ajuda">Desmarque para parar a exibição sem apagar nada.</p>
            </div>
        </section>

        <section class="formulario-secao">
            <fieldset class="campo{% if erros.gerentes is defined %} campo-erro{% endif %}">
                <legend><h2>Gerentes vinculados</h2></legend>
                <p class="secao-ajuda">Cada gerente só enxerga os condomínios aos quais está vinculado.</p>
                <div class="opcoes">
                    {% for g in gerentes %}
                        <label class="opcao">
                            <input type="checkbox" name="gerentes[]" value="{{ g.id }}"{% if g.id in valores.gerentes %} checked{% endif %}>
                            <span>{{ g.nome }}{% if not g.ativo %} <small>inativo</small>{% endif %}<small>{{ g.email }}</small></span>
                        </label>
                    {% else %}
                        <p class="campo-ajuda">Nenhum gerente cadastrado ainda.</p>
                    {% endfor %}
                </div>
                {% if erros.gerentes is defined %}<p class="erro-texto">{{ erros.gerentes }}</p>{% endif %}
            </fieldset>
        </section>

        {% if editando %}
        <section class="formulario-secao">
            <h2>Aparência na TV</h2>
            <p class="secao-ajuda">Logo e cores são definidas pelo gerente do condomínio. Sem personalização, vale o padrão da Embracore.</p>
            {% include 'partials/aparencia.html.twig' %}
        </section>
        {% endif %}

        <div class="acoes">
            <button type="submit">{{ editando ? 'Salvar alterações' : 'Criar condomínio' }}</button>
            <a class="botao botao-secundario" href="/admin/condominios">Cancelar</a>
        </div>
    </form>
{% endblock %}
