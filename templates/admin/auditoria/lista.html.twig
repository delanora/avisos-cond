{% extends 'layouts/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block titulo %}Auditoria - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <div class="pagina-topo">
        <div>
            <h1>Auditoria</h1>
            <p>Quem fez o quê, e quando. Os registros não podem ser alterados e são guardados por tempo limitado. Nunca guardamos senhas nem tokens.</p>
        </div>
    </div>

    <form method="get" action="/admin/auditoria" class="cartao filtros-auditoria">
        <div class="campo">
            <label for="f-grupo">Tipo de ação</label>
            <select id="f-grupo" name="grupo">
                <option value="">Todas</option>
                {% for chave, rotulo in grupos %}<option value="{{ chave }}"{% if filtros.grupo == chave %} selected{% endif %}>{{ rotulo }}</option>{% endfor %}
            </select>
        </div>
        <div class="campo">
            <label for="f-pessoa">Quem</label>
            <select id="f-pessoa" name="pessoa">
                <option value="">Todos</option>
                {% for p in pessoas %}<option value="{{ p.id }}"{% if filtros.pessoa == p.id %} selected{% endif %}>{{ p.nome }}</option>{% endfor %}
            </select>
        </div>
        <div class="campo">
            <label for="f-condominio">Condomínio</label>
            <select id="f-condominio" name="condominio">
                <option value="">Todos</option>
                {% for c in condominios %}<option value="{{ c.id }}"{% if filtros.condominio == c.id %} selected{% endif %}>{{ c.nome }}</option>{% endfor %}
            </select>
        </div>
        <div class="campo">
            <label for="f-de">De</label>
            <input id="f-de" type="date" name="de" value="{{ filtros.de }}">
        </div>
        <div class="campo">
            <label for="f-ate">Até</label>
            <input id="f-ate" type="date" name="ate" value="{{ filtros.ate }}">
        </div>
        <div class="acoes sem-margem filtros-acoes">
            <button type="submit">Filtrar</button>
            <a class="botao botao-secundario" href="/admin/auditoria">Limpar</a>
        </div>
    </form>

    {% if linhas|length == 0 %}
        <div class="cartao vazio">
            <span class="vazio-icone">{{ ui.icone('prancheta', 30) }}</span>
            <h2>Nenhum registro encontrado</h2>
            <p>Tente outro filtro ou um período maior.</p>
        </div>
    {% else %}
        <p class="campo-ajuda">{{ total }} {{ total == 1 ? 'registro' : 'registros' }}{% if total_paginas > 1 %} · página {{ pagina }} de {{ total_paginas }}{% endif %}</p>
        <div class="cartao cartao-sem-espaco">
            <div class="tabela-rolagem">
                <table>
                    <thead>
                        <tr>
                            <th>Quando</th>
                            <th>Quem</th>
                            <th>Ação</th>
                            <th class="esconde-movel">Detalhes</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for l in linhas %}
                        <tr>
                            <td class="celula-suave nowrap">{{ l.quando }}</td>
                            <td>
                                <span class="pessoa-nome">{{ l.usuario_nome ?? 'Pessoa removida' }}</span>
                                {% if l.como_usuario_nome %}<span class="pessoa-sub">em modo suporte, como {{ l.como_usuario_nome }}</span>{% endif %}
                                {% if l.ip %}<span class="pessoa-sub">IP {{ l.ip }}</span>{% endif %}
                            </td>
                            <td>
                                <span class="pessoa-nome">{{ l.rotulo }}</span>
                                {% if l.condominio_nome %}<span class="pessoa-sub">{{ l.condominio_nome }}</span>{% endif %}
                            </td>
                            <td class="celula-suave esconde-movel">
                                {% for chave, valor in l.detalhes %}<span class="detalhe-auditoria"><strong>{{ chave }}:</strong> {{ valor is same as(true) ? 'sim' : (valor is same as(false) ? 'não' : valor) }}</span>{% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if total_paginas > 1 %}
            <nav class="paginacao" aria-label="Páginas">
                {% if pagina > 1 %}<a class="botao botao-secundario" href="/admin/auditoria?{{ consulta }}{{ consulta ? '&' : '' }}pagina={{ pagina - 1 }}">Anteriores</a>{% endif %}
                {% if pagina < total_paginas %}<a class="botao botao-secundario" href="/admin/auditoria?{{ consulta }}{{ consulta ? '&' : '' }}pagina={{ pagina + 1 }}">Mais antigos</a>{% endif %}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
