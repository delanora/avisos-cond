{% extends 'layouts/base.html.twig' %}
{% import 'macros/form.html.twig' as f %}
{% import 'macros/ui.html.twig' as ui %}
{% set menu = 'usuarios' %}

{% block titulo %}{{ editando ? 'Editar usuário' : 'Novo usuário' }} - {{ app_nome }}{% endblock %}

{% block conteudo %}
    <p class="migalha"><a href="/admin/usuarios">Usuários</a> {{ ui.icone('seta', 14) }} <span>{{ editando ? 'Editar' : 'Novo' }}</span></p>
    <div class="pagina-topo">
        <div>
            <h1>{{ editando ? 'Editar usuário' : 'Novo usuário' }}</h1>
            <p>{{ editando ? 'Atualize os dados, o acesso e os condomínios desta pessoa.' : 'Cadastre uma pessoa e defina o que ela pode acessar.' }}</p>
        </div>
    </div>

    {% if erros.geral is defined %}<p class="alerta alerta-erro" role="alert">{{ ui.icone('alerta', 20) }}<span>{{ erros.geral }}</span></p>{% endif %}

    <form method="post" action="{{ acao }}" class="cartao formulario">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <section class="formulario-secao">
            <h2>Dados da pessoa</h2>
            <p class="secao-ajuda">O e-mail é usado para entrar no sistema e para recuperar a senha.</p>
            <div class="grade-2">
                {{ f.campo('nome', 'Nome', 'text', valores.nome, erros.nome|default(''), {obrigatorio: true, max: 150, autocomplete: 'name'}) }}
                {{ f.campo('email', 'E-mail', 'email', valores.email, erros.email|default(''), {obrigatorio: true, max: 190, autocomplete: 'off'}) }}
            </div>
        </section>

        <section class="formulario-secao">
            <h2>Acesso</h2>
            <p class="secao-ajuda">Gerentes enxergam só os condomínios vinculados. Administradores cuidam do painel da Embracore.</p>

            <div class="campo{% if erros.papel is defined %} campo-erro{% endif %}">
                <label for="campo-papel">Papel</label>
                <select id="campo-papel" name="papel"{% if editando and usuario_proprio %} disabled{% endif %}>
                    <option value="gerente"{% if valores.papel == 'gerente' %} selected{% endif %}>Gerente</option>
                    <option value="superadmin"{% if valores.papel == 'superadmin' %} selected{% endif %}>Administrador (equipe Embracore)</option>
                </select>
                {% if editando and usuario_proprio %}
                    <input type="hidden" name="papel" value="{{ valores.papel }}">
                    <p class="campo-ajuda">Você não pode alterar o seu próprio papel.</p>
                {% endif %}
                {% if erros.papel is defined %}<p class="erro-texto">{{ erros.papel }}</p>{% endif %}
            </div>

            {% if editando %}
            <div class="campo">
                <label class="opcao opcao-simples">
                    <input type="checkbox" name="ativo" value="1"{% if valores.ativo %} checked{% endif %}{% if usuario_proprio %} disabled{% endif %}>
                    Conta ativa
                </label>
                {% if usuario_proprio %}
                    <input type="hidden" name="ativo" value="1">
                    <p class="campo-ajuda">Você não pode desativar a sua própria conta.</p>
                {% else %}
                    <p class="campo-ajuda">Quem estiver com a conta inativa não consegue entrar no sistema.</p>
                {% endif %}
            </div>
            {% endif %}
        </section>

        <section class="formulario-secao">
            <h2>{{ editando ? 'Trocar a senha' : 'Senha' }}</h2>
            <p class="secao-ajuda">{{ editando ? 'Deixe em branco para manter a senha atual. Ao trocar, os acessos abertos desta pessoa são encerrados.' : 'Use pelo menos 10 caracteres. A pessoa poderá trocar depois pelo "Esqueci minha senha".' }}</p>
            <div class="grade-2">
                {{ f.campo('senha', editando ? 'Nova senha' : 'Senha', 'password', '', erros.senha|default(''), {obrigatorio: not editando, min: constant('App\\Services\\UsuarioService::SENHA_MIN'), max: 128, autocomplete: 'new-password'}) }}
                {{ f.campo('confirmacao', 'Confirme a senha', 'password', '', '', {obrigatorio: not editando, min: constant('App\\Services\\UsuarioService::SENHA_MIN'), max: 128, autocomplete: 'new-password'}) }}
            </div>
        </section>

        <section class="formulario-secao">
            <fieldset class="campo{% if erros.condominios is defined %} campo-erro{% endif %}">
                <legend><h2>Condomínios vinculados</h2></legend>
                <p class="secao-ajuda">Vale apenas para gerentes: marque os condomínios que esta pessoa pode gerenciar.</p>
                <div class="opcoes">
                    {% for c in condominios %}
                        <label class="opcao">
                            <input type="checkbox" name="condominios[]" value="{{ c.id }}"{% if c.id in valores.condominios %} checked{% endif %}>
                            <span>{{ c.nome }}{% if not c.ativo %} <small>inativo</small>{% endif %}</span>
                        </label>
                    {% else %}
                        <p class="campo-ajuda">Nenhum condomínio cadastrado ainda.</p>
                    {% endfor %}
                </div>
                {% if erros.condominios is defined %}<p class="erro-texto">{{ erros.condominios }}</p>{% endif %}
            </fieldset>
        </section>

        <div class="acoes">
            <button type="submit">{{ editando ? 'Salvar alterações' : 'Criar usuário' }}</button>
            <a class="botao botao-secundario" href="/admin/usuarios">Cancelar</a>
        </div>
    </form>
{% endblock %}
