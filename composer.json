{
    "name": "embracore/avisos-cond",
    "description": "Mural digital de avisos para condomínios",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
