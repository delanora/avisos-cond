APP_ENV=production
APP_URL=https://avisos.exemplo.com.br
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=avisos_cond
DB_USER=avisos
DB_PASS=

SESSION_NAME=avisos_sess
UPLOAD_DIR=/var/www/avisos-cond/storage/uploads
UPLOAD_MAX_MB=10
# Dias que a auditoria é guardada (mínimo 30)
AUDITORIA_RETENCAO_DIAS=365
# Com Nginx, entrega as mídias por X-Accel-Redirect (location /media/ interna). Vazio = o PHP envia o arquivo.
MEDIA_ACCEL=/media/

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Nome que aparece como remetente (padrão: Avisos-Cond). Para Gmail/Google Workspace: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USER = endereço completo da conta, MAIL_PASS = senha de app (não a senha normal) e MAIL_FROM = o mesmo endereço (ou um apelido dele).
MAIL_FROM_NAME=Avisos-Cond

# Opcional: usuário com permissão de DDL só para as migrations.
MIGRATE_DB_USER=
MIGRATE_DB_PASS=

# Intervalo (em segundos, de 30 a 60) com que a TV consulta o servidor.
TV_POLL_SECONDS=45

# Opcional: pasta dos logs (padrão: storage/logs).
# LOG_DIR=

# Backup (bin/backup.sh): pasta de destino e quantos dias guardar (padrões abaixo).
# BACKUP_DIR=/var/backups/avisos-cond
# BACKUP_KEEP_DAYS=14
